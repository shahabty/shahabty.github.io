---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Projects"
  description="Selected open-source and research projects by Shahab Nabavi across computer vision and machine learning."
  path="/projects"
>
  <section class="page-hero">
    <div class="container">
      <p class="section__eyebrow">Projects</p>
      <h1>Work I can point to when curiosity leaves fingerprints.</h1>
      <p class="section__lede">
        A curated set of public repositories — mostly computer vision and deep learning experiments from along the way.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <ul class="list-plain">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
