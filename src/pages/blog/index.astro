---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import PostCard from '../../components/PostCard.astro';
import { sortByDateDesc } from '../../lib/dates';
import { estimateReadingTimeMinutes } from '../../lib/readingTime';

const posts = sortByDateDesc(await getCollection('blog', ({ data }) => !data.draft));
---

<BaseLayout
  title="Blog"
  description="Writing by Shahab Nabavi across Field Notes (AI), Quiet Thoughts, and Frame Notes (film and theatre)."
  path="/blog"
>
  <section class="page-hero">
    <div class="container">
      <p class="section__eyebrow">Blog</p>
      <h1>Blog</h1>
      <p class="section__lede">
        Writing in three places: Field Notes for AI work, Quiet Thoughts for personal stuff, and Frame Notes for film, theatre, science, and the future.
      </p>
      <CategoryFilters active="all" />
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <ul class="list-plain">
        {
          posts.map((post) => (
            <li>
              <PostCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id}/`}
                pubDate={post.data.pubDate}
                category={post.data.category}
                readingMinutes={estimateReadingTimeMinutes(post.body ?? '')}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
