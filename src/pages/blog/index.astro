---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilters from '../../components/CategoryFilters.astro';
import PostCard from '../../components/PostCard.astro';
import { sortByDateDesc } from '../../lib/dates';
import { estimateReadingTimeMinutes } from '../../lib/readingTime';

const posts = sortByDateDesc(await getCollection('blog', ({ data }) => !data.draft));
---

<BaseLayout
  title="Blog"
  description="Writing by Shahab Nabavi across Field Notes (AI), Quiet Thoughts, and Frame Notes (film and theatre)."
  path="/blog/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Blog</h1>
      <CategoryFilters active="all" />
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <ul class="list-plain">
        {
          posts.map((post) => (
            <li>
              <PostCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id}/`}
                pubDate={post.data.pubDate}
                category={post.data.category}
                readingMinutes={estimateReadingTimeMinutes(post.body ?? '')}
                tags={post.data.tags}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <script is:inline>
    addEventListener('pageshow', (event) => {
      if (event.persisted) location.reload();
    });
  </script>
</BaseLayout>
