---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../data/site';
import { withBuildId } from '../lib/buildId';
import { getCollection } from 'astro:content';
import { sortByDateDesc } from '../lib/dates';
import { estimateReadingTimeMinutes } from '../lib/readingTime';

const posts = sortByDateDesc(
  (await getCollection('blog', ({ data }) => !data.draft)).slice(),
).slice(0, 3);

const { advisor } = siteConfig.author;

function renderBioParagraph(paragraph: string) {
  const marker = advisor.name;
  const index = paragraph.indexOf(marker);
  if (index === -1) {
    return paragraph;
  }

  return {
    before: paragraph.slice(0, index),
    after: paragraph.slice(index + marker.length),
  };
}
---

<BaseLayout title={siteConfig.name} path="/">
  <section class="hero">
    <div class="container">
      <p class="hero__brand">{siteConfig.name}</p>
      <h1 class="hero__title">{siteConfig.title}</h1>
      <div class="cta-row">
        <a class="button button--primary" href={withBuildId('/blog/')}>Read the blog</a>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container split about-layout">
      <div class="prose">
        <p class="section__eyebrow">About</p>
        {
          siteConfig.author.longBio.map((paragraph) => {
            const linked = renderBioParagraph(paragraph);
            if (typeof linked === 'string') {
              return <p>{linked}</p>;
            }

            return (
              <p>
                {linked.before}<a href={advisor.url} target="_blank" rel="noopener noreferrer">{advisor.name}</a>{linked.after}
              </p>
            );
          })
        }
        <p>
          You can find me on <a href={siteConfig.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>, <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>, and <a href={siteConfig.links.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>.
        </p>
      </div>
      <aside class="about-panel" aria-label="Quick facts">
        <dl>
          <dt>Based in</dt>
          <dd>{siteConfig.author.location}</dd>
          <dt>Interests</dt>
          <dd>{siteConfig.author.interests.join(', ')}</dd>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="section__eyebrow">Recent writing</p>
        <h2 class="section__title">A few recent posts</h2>
        <p class="section__lede">
          Some are about AI. Some are more personal. Some are about film, theatre, science, and the future.
        </p>
      </div>
      <div class="stack">
        {
          posts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.id}/`}
              pubDate={post.data.pubDate}
              category={post.data.category}
              readingMinutes={estimateReadingTimeMinutes(post.body ?? '')}
              tags={post.data.tags}
            />
          ))
        }
        <p><a href={withBuildId('/blog/')}>All posts →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
