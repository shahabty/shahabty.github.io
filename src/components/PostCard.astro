---
import { getCategory, type CategoryId } from '../lib/categories';
import { formatDate, toIsoDate } from '../lib/dates';
import { readingTimeLabel } from '../lib/readingTime';

type Props = {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  category: CategoryId;
  readingMinutes: number;
  tags?: readonly string[];
};

const { title, description, href, pubDate, category, readingMinutes, tags = [] } = Astro.props;
const categoryMeta = getCategory(category);
---

<article class="post-card">
  <div class="meta">
    <a class="badge" href={categoryMeta.path}>{categoryMeta.name}</a>
    <time datetime={toIsoDate(pubDate)}>{formatDate(pubDate)}</time>
    <span>{readingTimeLabel(readingMinutes)}</span>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <p class="topics">
        {tags.map((tag) => (
          <span>#{tag}</span>
        ))}
      </p>
    )
  }
</article>
