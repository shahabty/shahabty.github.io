---
import { getCategory, type CategoryId } from '../lib/categories';
import { formatDate } from '../lib/dates';
import { readingTimeLabel } from '../lib/readingTime';

type Props = {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  category: CategoryId;
  readingMinutes: number;
};

const { title, description, href, pubDate, category, readingMinutes } = Astro.props;
const categoryMeta = getCategory(category);
---

<article class="post-card">
  <div class="meta">
    <a class="badge" href={categoryMeta.path}>{categoryMeta.name}</a>
    <span> · {formatDate(pubDate)} · {readingTimeLabel(readingMinutes)}</span>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
</article>
