---
import { listCategories, type CategoryId } from '../lib/categories';
import { withBuildId } from '../lib/buildId';

type Props = {
  active?: CategoryId | 'all';
};

const { active = 'all' } = Astro.props;
const categories = listCategories();
---

<nav class="category-filters" aria-label="Blog categories">
  <a href={withBuildId('/blog/')} aria-current={active === 'all' ? 'page' : undefined}>All</a>
  {
    categories.map((category) => (
      <a href={withBuildId(category.path)} aria-current={active === category.id ? 'page' : undefined}>
        {category.name}
      </a>
    ))
  }
</nav>
