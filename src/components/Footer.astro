---
import { siteConfig } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>© {year} {siteConfig.name}</p>
    <div class="socials">
      <a href={siteConfig.links.github} rel="me noopener noreferrer" target="_blank">GitHub</a>
      <a href={siteConfig.links.linkedin} rel="me noopener noreferrer" target="_blank">LinkedIn</a>
      <a href={siteConfig.links.scholar} rel="me noopener noreferrer" target="_blank">Scholar</a>
      <a href="/rss.xml">RSS</a>
      <a href="/llms.txt">llms.txt</a>
    </div>
  </div>
</footer>
